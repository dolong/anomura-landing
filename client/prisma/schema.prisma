// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model WhiteList {
  id              Int    @id @default(autoincrement())
  wallet          String
  discordID       String
  numberOfInvites Int
}

model Anomuras {
  id    Int    @id @default(autoincrement())
  crabId Int
  owner String
  background  String
  legs  String
  shell String
  claws String
  body  String
  image String

  Players       Players? @relation(fields: [playersWallet], references: [wallet])
  playersWallet String?
}

model Players {
  wallet        String     @id
  ownedAnomuras Anomuras[]
}
